// 2026-11-17 時点のバックアップ : 実際は GitHub アカウントで同期しているのでソチラを利用すれば OK
{
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.tools.terminal.autoApprove": {
    "true": true
  },
  "chat.viewSessions.orientation": "stacked",
  
  "chatgpt.composerEnterBehavior": "cmdAlways",
  "chatgpt.followUpQueueMode": "steer",
  "chatgpt.localeOverride": "ja-JP",
  "chatgpt.reviewDelivery": "detached",
  "chatgpt.runCodexInWindowsSubsystemForLinux": true,
  
  "css.lint.duplicateProperties": "warning",
  "css.lint.zeroUnits": "warning",
  
  "diffEditor.maxComputationTime": 0,
  
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,  // Bracket Pair Colorizer 同等機能だがカラーリングが違うので一旦無効化しておく
  "editor.codeLens": false,
  "editor.fontFamily": "'M PLUS 1 Code Medium', 'Noto Sans Mono CJK JP', MeiryoKe_Gothic, monospace",
  "editor.fontSize": 14.5,
  "editor.minimap.enabled": false,
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",
  "editor.scrollBeyondLastLine": false,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  
  "extensions.ignoreRecommendations": true,
  
  "files.eol": "\n",
  "files.exclude": {
    "**/.qodo": true
  },
  "files.trimTrailingWhitespace": false,
  
  "git.blame.editorDecoration.enabled": false,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "never",
  "git.path": "C:\\git-sdk-64\\usr\\bin\\git.exe",
  
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.completionsFetcher": "node-fetch",
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
  "github.copilot.chat.localeOverride": "ja",
  "github.copilot.enable": {
    "plaintext": false,
    "markdown": false,
    "*": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  
  "html.autoClosingTags": false,
  "html.format.extraLiners": "",
  "html.format.indentInnerHtml": true,
  
  "http.systemCertificatesNode": true,
  
  "js/ts.implicitProjectConfig.experimentalDecorators": true,
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  
  "markdown-preview-enhanced.codeBlockTheme": "monokai.css",
  "markdown-preview-enhanced.frontMatterRenderingOption": "table",
  
  "merge-conflict.codeLens.enabled": false,
  
  "problems.autoReveal": false,
  "problems.decorations.enabled": false,
  
  "python.venvPath": ".venv",
  
  "remote.autoForwardPortsSource": "hybrid",
  
  "scm.diffDecorationsGutterPattern": {
    "added": true
  },
  
  "scss.lint.duplicateProperties": "warning",
  "scss.lint.zeroUnits": "warning",
  
  "search.exclude": {
    "**/node_modules": true
  },
  
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "security.promptForLocalFileProtocolHandling": false,
  "security.promptForRemoteFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "open",
  
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  
  "terminal.explorerKind": "both",
  "terminal.external.windowsExec": "C:\\git-sdk-64\\usr\\bin\\bash.exe",
  "terminal.integrated.allowInUntrustedWorkspace": true,
  "terminal.integrated.automationProfile.windows": {
    "path": "C:\\git-sdk-64\\usr\\bin\\bash.exe",
    "args": ["-l"]
  },
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.windows": "GitSDK",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "Menlo, MeiryoKe_Gothic, 'Noto Sans Mono CJK JP', monospace",
  "terminal.integrated.fontWeight": "bold",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.profiles.windows": {
    "GitSDK": {
      "path": "C:\\git-sdk-64\\usr\\bin\\bash.exe",
      "args": [
        "-l",
        "-i"
      ]
    },
    "Ubuntu (WSL)": {
      "path": "C:\\WINDOWS\\System32\\wsl.exe",
      "args": [
        "-d",
        "Ubuntu"
      ]
    },
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  
  "update.showReleaseNotes": false,
  
  "window.customTitleBarVisibility": "windowed",
  "window.customMenuBarAltFocus": false,
  "window.density.layout": "compact",
  "window.menuBarVisibility": "visible",
  "window.titleBarStyle": "custom",
  
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "editor.foreground"         : "#ffffff",
    "editor.background"         : "#121416",
    "terminal.foreground"       : "#ffffff",
    "terminal.background"       : "#000000",
    "terminal.ansiBlack"        : "#646464",
    "terminal.ansiBrightBlack"  : "#646464",
    "terminal.ansiRed"          : "#ff0000",
    "terminal.ansiBrightRed"    : "#ff0000",
    "terminal.ansiGreen"        : "#00ff00",
    "terminal.ansiBrightGreen"  : "#00ff00",
    "terminal.ansiYellow"       : "#ffff00",
    "terminal.ansiBrightYellow" : "#ffff00",
    "terminal.ansiBlue"         : "#008cff",
    "terminal.ansiBrightBlue"   : "#008cff",
    "terminal.ansiMagenta"      : "#ff00ff",
    "terminal.ansiBrightMagenta": "#ff00ff",
    "terminal.ansiCyan"         : "#00ffff",
    "terminal.ansiBrightCyan"   : "#00ffff",
    "terminal.ansiWhite"        : "#ffffff",
    "terminal.ansiBrightWhite"  : "#ffffff"
  },
  "workbench.colorTheme": "Neos21",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editorAssociations": {
    "*.db": "default"
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.quickOpen.closeOnFocusLost": false,
  "workbench.startupEditor": "newUntitledFile"
}
